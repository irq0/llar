{:twitter-api {:app-key ""
               :app-secret ""
               :user-token ""
               :user-token-secret ""}
 :youtube {:api-key ""}
 :imap {:username ""
        :password ""}
 ;; Create a "script" app at https://www.reddit.com/prefs/apps
 ;; :app-id and :secret authenticate via the client_credentials grant.
 ;; :username is only used to build the user agent reddit requires.
 :reddit {:app-id ""
          :secret ""
          :username ""}
 ;; Generate a different value for each client with: openssl rand -hex 32
 :bookmark-capture {:tokens {:iphone "replace-with-64-hex-characters"
                             :macbook "replace-with-64-hex-characters"
                             :firefox "replace-with-64-hex-characters"}}
 ;; Config Lab is intentionally separate from capture clients. Generate with:
 ;; openssl rand -hex 32
 :config-lab {:tokens {:dashboard "replace-with-64-hex-characters"}}}
